{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/SearchIQ.html",
      "has": [
        {
          "type": "host",
          "value": "searchiq.heyproxy.io"
        }
      ]
    }
  ]
}

